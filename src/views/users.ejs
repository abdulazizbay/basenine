<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/users.css" />

<body>
  <div class="users-container">

    <nav class="admin-navbar">
      <div class="admin-navbar-inner">
        <a class="brand" href="/admin">
          <span class="brand-mark">B9</span>
          <span class="brand-name">BaseNine</span>
        </a>

        <ul class="nav-links">
          <li><a class="nav-link" href="/admin">Home</a></li>

          <% if (!member) { %>
          <li><a class="nav-link" href="/admin/signup">Signup</a></li>
          <li><a class="nav-link" href="/admin/login">Login</a></li>
          <% } else { %>
          <li><a class="nav-link active" href="/admin/user/all">Users</a></li>
          <li><a class="nav-link" href="/admin/player/all">Players</a></li>
          <li><a class="nav-link" href="/admin/team/all">Teams</a></li>
          <li><a class="nav-link" href="/admin/game/all">Games</a></li>
          <li><a class="nav-link" href="/admin/product/all">Products</a></li>
  
          <li>
            <a
              class="nav-link logout-link"
              href="/admin/logout"
              onclick="return confirm('Do you really want to logout?')"
            >Logout</a>
          </li>
          <% } %>
        </ul>
      </div>
    </nav>

    <% if (!member) { %>

      <main class="users-frame">
        <div class="auth-notice">
          <span class="auth-notice-tag">Restricted</span>
          <h1>Please login first</h1>
          <p>You need to be signed in to view the users list.</p>
          <a class="btn btn-primary" href="/admin/login">Login</a>
        </div>
      </main>

    <% } else { %>

      <main class="users-frame">
        <div class="board">
          <div class="page-header">
            <div>
              <span class="eyebrow">Members</span>
              <h1>All Users</h1>
              <p><%= users.length %> total</p>
            </div>
          </div>

          <div class="user-table">
            <table class="table">
              <thead>
                <tr>
                  <th scope="col">No</th>
                  <th scope="col">Name</th>
                  <th scope="col">Phone</th>
                  <th scope="col">Status</th>
                </tr>
              </thead>
              <tbody>
                <% users.map(function(value, index) { %>
                <tr>
                  <td class="cell-muted"><%= index + 1 %></td>
                  <td class="cell-name"><%= value.memberNick %></td>
                  <td><%= value.memberPhone %></td>
                  <td>
                    <select class="spec-select member-status status-<%= value.memberStatus.toLowerCase() %>" id="<%= value._id %>">
                      <option value="ACTIVE" <%= value.memberStatus === "ACTIVE" ? "selected" : "" %>>ACTIVE</option>
                      <option value="BLOCK" <%= value.memberStatus === "BLOCK" ? "selected" : "" %>>BLOCK</option>
                      <option value="DELETE" <%= value.memberStatus === "DELETE" ? "selected" : "" %>>DELETE</option>
                    </select>
                  </td>
                </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </main>

    <% } %>
  </div>

  <script type="text/javascript" src="/js/users.js"></script>
</body>

<%- include('includes/footer') %>
