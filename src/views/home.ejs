<%- include('includes/header') %>

<link rel="stylesheet" type="text/css" href="/css/home.css" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/animejs/3.2.1/anime.js"></script>

<body>
  <div class="home-container">

    <nav class="admin-navbar">
      <div class="admin-navbar-inner">
        <a class="brand" href="/admin">
          <span class="brand-mark">B9</span>
          <span class="brand-name">BaseNine</span>
        </a>

        <ul class="nav-links">
          <li><a class="nav-link active" href="/admin">Home</a></li>

          <% if (!member) { %>
          <li><a class="nav-link" href="/admin/signup">Signup</a></li>
          <li><a class="nav-link" href="/admin/login">Login</a></li>
          <% } else { %>
          <li><a class="nav-link" href="/admin/user/all">Users</a></li>
          <li><a class="nav-link" href="/admin/player/all">Players</a></li>
          <li><a class="nav-link" href="/admin/team/all">Teams</a></li>
          <li><a class="nav-link" href="/admin/game/all">Games</a></li>
          <li><a class="nav-link" href="/admin/product/all">Products</a></li>
          <li>
            <a
              class="nav-link logout-link"
              href="/admin/logout"
              onclick="return confirm('Do you want to logout?')"
            >Logout</a>
          </li>
          <% } %>
        </ul>
      </div>
    </nav>

    <main class="dashboard">
      <% if (!member) { %>

        <section class="welcome-panel" id="welcomePanel">
          <span class="welcome-tag">BaseNine Admin</span>
          <h1>Welcome back</h1>
          <p>Sign in to manage users, players, teams, games, products.</p>
          <div class="welcome-actions">
            <a class="btn btn-primary" href="/admin/login">Login</a>
            <a class="btn btn-outline" href="/admin/signup">Create an account</a>
          </div>
        </section>

      <% } else { %>

        <div class="dashboard-header">
          <h1>Dashboard</h1>
          <p>Overview of the resources you manage.</p>
        </div>

        <div class="card-grid" id="cardGrid">
          <a class="dash-card" href="/admin/user/all">
            <div class="dash-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="3.4"/><path d="M4.5 20c1.4-3.6 4.4-5.6 7.5-5.6s6.1 2 7.5 5.6"/></svg>
            </div>
            <div class="dash-card-body">
              <h3>Users</h3>
              <p>Manage accounts and access</p>
            </div>
          </a>

          <a class="dash-card" href="/admin/player/all">
            <div class="dash-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3v6M12 15v6M4.5 8.5l15 7M19.5 8.5l-15 7"/></svg>
            </div>
            <div class="dash-card-body">
              <h3>Players</h3>
              <p>View and edit player records</p>
            </div>
          </a>

          <a class="dash-card" href="/admin/team/all">
            <div class="dash-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="8" cy="9" r="2.6"/><circle cx="16" cy="9" r="2.6"/><path d="M2.8 19c1-2.8 3-4.3 5.2-4.3s4.2 1.5 5.2 4.3M10.8 19c1-2.8 3-4.3 5.2-4.3s4.2 1.5 5.2 4.3"/></svg>
            </div>
            <div class="dash-card-body">
              <h3>Teams</h3>
              <p>Organize rosters and teams</p>
            </div>
          </a>

          <a class="dash-card" href="/admin/game/all">
            <div class="dash-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="7" width="18" height="10" rx="3"/><path d="M8 10v4M6 12h4M15.5 11.5h.01M18 13.5h.01"/></svg>
            </div>
            <div class="dash-card-body">
              <h3>Games</h3>
              <p>Schedule and track games</p>
            </div>
          </a>

          <a class="dash-card" href="/admin/product/all">
            <div class="dash-card-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 8l8-4 8 4-8 4-8-4z"/><path d="M4 8v8l8 4 8-4V8"/><path d="M12 12v8"/></svg>
            </div>
            <div class="dash-card-body">
              <h3>Products</h3>
              <p>Manage catalog and inventory</p>
            </div>
          </a>

        </div>

      <% } %>
    </main>
  </div>

  <script type="text/javascript" src="/js/home.js"></script>
</body>

<%- include('includes/footer') %>
